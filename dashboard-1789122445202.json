        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Vitals_Recovery",
          "description": "show that after buffered readings i adapt the timestamp of arrival",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "cfxf3viebtkhse"
                      },
                      "spec": {
                        "query": "from(bucket: \"vital_signs\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"patient_vitals\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"heart_rate\" or r[\"_field\"] == \"respiration_rate\" or r[\"_field\"] == \"spo2\")\r\n  |> aggregateWindow(every: 5s, fn: last, createEmpty: false)\r\n  |> yield(name: \"vitals\")"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
